# ── Capture interface ──────────────────────────────────────────────────────────
CAPTURE_INTERFACE=eth1          # real NIC name in HARDWARE mode
CAPTURE_MODE=live               # live | pcap_file | loopback
PCAP_FILE_PATH=                 # path to .pcap, used when CAPTURE_MODE=pcap_file

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_CHANNEL_RAW=flow.raw
REDIS_CHANNEL_HEALTH=ingestion.health
REDIS_PUBLISH_TIMEOUT_MS=100
REDIS_MAX_QUEUE_DEPTH=10000

# ── Zeek ───────────────────────────────────────────────────────────────────────
ZEEK_LOG_DIR=/tmp/zeek_logs
ZEEK_SCRIPTS_DIR=ingestion/capture/config

# ── Flow assembly ──────────────────────────────────────────────────────────────
FLOW_IDLE_TIMEOUT_S=120
FLOW_MAX_PACKETS=10000

# ── Sensor identity ────────────────────────────────────────────────────────────
SENSOR_ID=diode-sensor-01
PIPELINE_VERSION=1.0.0

# ── Monitoring ─────────────────────────────────────────────────────────────────
METRICS_PORT=9101
LOG_LEVEL=INFO

# ── Run mode (overridden by CLI menu selection) ────────────────────────────────
RUN_MODE=simulation             # hardware | simulation
