# Backend API base URL (Person 4's Express service)
VITE_API_URL=http://localhost:4000

# WebSocket endpoint that streams standardized JSON alerts
VITE_WS_URL=ws://localhost:4000/ws

# When true, the dashboard runs entirely on the local mock alert generator
# and never attempts a real WebSocket connection. Flip to false once
# Person 4's backend is reachable at VITE_WS_URL.
VITE_USE_MOCK_DATA=false
