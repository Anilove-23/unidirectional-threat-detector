# Server Configuration
PORT=4000
NODE_ENV=development

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Database Configuration (PostgreSQL / MongoDB / In-Memory Fallback)
DATABASE_URL=postgres://user:pass@localhost:5432/sih_alerts
MONGODB_URI=mongodb://localhost:27017/sih_alerts
DB_TYPE=memory

# Streaming Configuration
REDIS_ALERT_CHANNEL=alert.new
REDIS_FLOW_CHANNEL=flow.raw
